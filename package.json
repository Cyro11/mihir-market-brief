{
  "name": "mihir-market-brief",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch": "node scripts/fetch-sources.js",
    "fetch:visuals": "node scripts/fetch-visual-data.js",
    "fetch:calendar": "node scripts/fetch-calendar.js",
    "analyze": "node scripts/build-edition.js",
    "review": "node scripts/review-edition.js",
    "render": "node scripts/render-edition.js",
    "daily": "npm run fetch && npm run fetch:visuals && npm run fetch:calendar && npm run analyze && npm run review && npm run render",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "build": "npm run render && node scripts/build-static.js",
    "dev": "npm run render && node scripts/serve-static.js",
    "preview": "node scripts/serve-static.js dist"
  },
  "dependencies": {},
  "devDependencies": {}
}
